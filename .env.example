# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL (Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# service_role key — NEVER expose this in the browser or commit it to git
# (Settings → API → Project API keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Name of the Storage bucket you created (default shown below)
SUPABASE_BUCKET=xonix-images

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
